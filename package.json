{
  "name": "scribe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --check .",
    "check": "tsc --noEmit && eslint . --max-warnings 0 && prettier --check . && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "test": "vitest run && cargo test --manifest-path src-tauri/Cargo.toml",
    "replay": "tsx scripts/replay.ts",
    "golden": "tsx scripts/golden.ts",
    "screenshot": "tsx scripts/screenshot.ts",
    "e2e": "playwright test",
    "ipc": "cargo test --manifest-path src-tauri/Cargo.toml export_ipc -- --ignored"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.105",
    "@ai-sdk/openai-compatible": "^3.0.92",
    "@base-ui/react": "^1.9.0",
    "@dagrejs/dagre": "^3.1.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.5",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-sql": "^2.6.0",
    "@tauri-apps/plugin-store": "^2.5.1",
    "@xyflow/react": "^13.0.1",
    "ai": "^7.0.173",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.74.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.1.18",
    "ulid": "^3.0.2",
    "wavesurfer.js": "^8.1.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.63.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^4.0.15"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
